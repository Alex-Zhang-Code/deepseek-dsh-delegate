{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/schemas/dsh-task.schema.json",
  "title": "DeepSeek Harness delegated task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "objective",
    "working_directory",
    "mode",
    "expected_output",
    "acceptance_criteria"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "working_directory": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": ["read_only", "workspace_write"]
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": []
    },
    "forbidden_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": []
    },
    "context": {
      "type": "string",
      "default": ""
    },
    "expected_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "requirements"],
      "properties": {
        "format": {
          "enum": ["text", "markdown", "json"]
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "session_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300,
      "default": 120
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "boolean", "null"]
      },
      "default": {}
    }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "workspace_write" } } },
      "then": { "required": ["allowed_paths"], "properties": { "allowed_paths": { "minItems": 1 } } }
    }
  ]
}
